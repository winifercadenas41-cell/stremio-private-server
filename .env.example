# Puerto del servidor
PORT=3000

# Tu clave secreta de Torbox (obtenida de https://torbox.app/settings)
TORBOX_API_KEY=tu_api_key_de_torbox_aqui

# Contraseña maestra para acceder al panel de administración /admin
ADMIN_PASSWORD=SuperAdminPassword123!

# URL pública de tu servidor (en Render será https://tu-servicio.onrender.com)
BASE_URL=http://localhost:3000

# Nombre de tu servicio que verán los usuarios en Stremio
SERVICE_NAME=Torbox VIP Streams
